# ==============================================================================
# Server Environment Configuration - Pakan Ikan
# Salin file ini menjadi server/.env untuk konfigurasi lokal
# JANGAN PERNAH mengunggah file server/.env ke repository publik!
# ==============================================================================

# Server Runtime
HOST=127.0.0.1
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# Allowed Origins for CORS (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:5173,https://pakan-ikan.my.id

# Firebase Configuration
FIREBASE_PROJECT_ID=pakan-ikan-4c18e
FIREBASE_API_KEY=AIzaSyDO4JXKcHrTcufS9LavNMLGhpwJxYbdUP8
FIREBASE_DATABASE_URL=https://pakan-ikan-4c18e-default-rtdb.asia-southeast1.firebasedatabase.app

# ESP32 Device Authentication
# Digunakan untuk otentikasi hardware ESP32 (menggunakan header X-Device-Key)
DEVICE_API_KEY=pakan-ikan-esp32-secret-2026
DEFAULT_DEVICE_ID=fish-feeder-001

# Firebase Admin Service Account Key:
# Opsi 1: Path relatif atau absolut ke file JSON service account (JANGAN di-commit ke Git)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Opsi 2: String JSON lengkap (berguna untuk deployment environment seperti Railway/Docker)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=katasandi.pakanikan@gmail.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM_NAME="Pakan Ikan"
SMTP_FROM_EMAIL=katasandi.pakanikan@gmail.com

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=20

