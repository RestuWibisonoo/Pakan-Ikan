# ==============================================================================
# Pakan Ikan - Systemd Service Unit for Node.js Express Backend
# ==============================================================================
# File Location: /etc/systemd/system/pakan-ikan-api.service
#
# Management commands:
#   sudo systemctl daemon-reload
#   sudo systemctl enable pakan-ikan-api
#   sudo systemctl start pakan-ikan-api
#   sudo systemctl status pakan-ikan-api
#   sudo journalctl -u pakan-ikan-api -f
# ==============================================================================

[Unit]
Description=Pakan Ikan IoT Backend API Service
Documentation=https://github.com/RestuWibisonoo/Pakan-Ikan
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/pakan-ikan/server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

# Environment Configuration
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=HOST=127.0.0.1
EnvironmentFile=-/var/www/pakan-ikan/server/.env

# Security Sandbox Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Resource Limits
LimitNOFILE=65535

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pakan-ikan-api

[Install]
WantedBy=multi-user.target

